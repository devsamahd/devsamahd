# Local development: copy this file to .env.local. Next.js does not load .env.example.
# Required in production. Choose a unique password of at least 24 characters.
CMS_PASSWORD=
# Generate a separate random secret of at least 32 characters.
CMS_SESSION_SECRET=
# Optional absolute path on a persistent disk. Default: ./data/cms
CMS_DATA_DIR=
# Public canonical URL used by metadata, sitemap, robots, and JSON-LD.
NEXT_PUBLIC_SITE_URL=https://samahd.is-a.dev
# Optional: automated CV tailoring. Manual editing, presets, and exports work without these.
OPENAI_API_KEY=
# A model with structured output support, available to your account.
OPENAI_MODEL=
