# Required in production. Choose a unique password of at least 24 characters.
CMS_PASSWORD=
# Generate a separate random secret of at least 32 characters.
CMS_SESSION_SECRET=
# Optional absolute path on a persistent disk. Default: ./data/cms
CMS_DATA_DIR=
# Optional: CV tailoring. Manual editing, presets, and exports work without these.
OPENAI_API_KEY=
# A Responses API model with Structured Outputs support, available to your account.
OPENAI_MODEL=
